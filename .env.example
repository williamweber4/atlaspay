# App name + supabase demo keys (optional)
NEXT_PUBLIC_APP_NAME=AtlasPay
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Rail settings
RAIL_CLIENT_ID=
RAIL_CLIENT_SECRET=
RAIL_SCOPES="payments:read payments:write"
RAIL_ENV=sandbox
# Set to true to use mocked Rail responses locally
RAIL_MOCK=true
